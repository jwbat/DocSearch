# For `npm run dev` only. Copy to .env.development.local (git-ignored) and
# fill in. Vite loads that file in dev mode but not for `npm run build`, so
# the hosted build keeps calling the API at its own (CloudFront) origin.
# The value is the ApiUrl output of DocSearchWebStack:
#   aws cloudformation describe-stacks --profile personal --region us-west-2 \
#     --stack-name DocSearchWebStack \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-west-2.amazonaws.com/
